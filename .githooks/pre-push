#!/bin/sh
set -eu

run_python() {
    if command -v python3 >/dev/null 2>&1; then
        python3 "$@"
    elif command -v python >/dev/null 2>&1; then
        python "$@"
    elif command -v py >/dev/null 2>&1; then
        py -3 "$@"
    else
        echo "Python 3 is required for repository evolution validation." >&2
        exit 1
    fi
}

zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        commits=$(git rev-list --reverse "$local_sha" --not --remotes="$1")
        if [ -z "$commits" ]; then
            run_python tools/evolution.py validate --document-only
        else
            for commit_sha in $commits; do
                run_python tools/evolution.py validate --commit "$commit_sha"
            done
        fi
    else
        run_python tools/evolution.py validate --range "$remote_sha..$local_sha"
    fi
done

