#!/bin/sh
set -eu

run_python() {
    if command -v python3 >/dev/null 2>&1; then
        python3 "$@"
    elif command -v python >/dev/null 2>&1; then
        python "$@"
    elif command -v py >/dev/null 2>&1; then
        py -3 "$@"
    else
        echo "Python 3 is required for repository evolution validation." >&2
        exit 1
    fi
}

run_python tools/evolution.py validate-message --message-file "$1"


